{
  "framework": "nuxtjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".output/public",
  "installCommand": "npm ci",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.tomeuferments.es/es/",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "tomeuferments.es"
        }
      ]
    },
    {
      "source": "/sobre-nosotros",
      "destination": "https://www.tomeuferments.es/es/#historia",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "tomeuferments.es"
        }
      ]
    },
    {
      "source": "/sobre-nosotros/",
      "destination": "https://www.tomeuferments.es/es/#historia",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "tomeuferments.es"
        }
      ]
    },
    {
      "source": "/about",
      "destination": "https://www.tomeuferments.es/en/#historia",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "tomeuferments.es"
        }
      ]
    },
    {
      "source": "/about/",
      "destination": "https://www.tomeuferments.es/en/#historia",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "tomeuferments.es"
        }
      ]
    },
    {
      "source": "/uber",
      "destination": "https://www.tomeuferments.es/en/#historia",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "tomeuferments.es"
        }
      ]
    },
    {
      "source": "/uber/",
      "destination": "https://www.tomeuferments.es/en/#historia",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "tomeuferments.es"
        }
      ]
    },
    {
      "source": "/contact",
      "destination": "https://www.tomeuferments.es/es/#contacto",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "tomeuferments.es"
        }
      ]
    },
    {
      "source": "/contact/",
      "destination": "https://www.tomeuferments.es/es/#contacto",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "tomeuferments.es"
        }
      ]
    },
    {
      "source": "/kontakt",
      "destination": "https://www.tomeuferments.es/en/#contacto",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "tomeuferments.es"
        }
      ]
    },
    {
      "source": "/kontakt/",
      "destination": "https://www.tomeuferments.es/en/#contacto",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "tomeuferments.es"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tomeuferments.es"
        }
      ],
      "destination": "https://www.tomeuferments.es/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/es/",
      "permanent": true
    },
    {
      "source": "/sobre-nosotros",
      "destination": "/es/#historia",
      "permanent": true
    },
    {
      "source": "/sobre-nosotros/",
      "destination": "/es/#historia",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/en/#historia",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/en/#historia",
      "permanent": true
    },
    {
      "source": "/uber",
      "destination": "/en/#historia",
      "permanent": true
    },
    {
      "source": "/uber/",
      "destination": "/en/#historia",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/es/#contacto",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/es/#contacto",
      "permanent": true
    },
    {
      "source": "/kontakt",
      "destination": "/en/#contacto",
      "permanent": true
    },
    {
      "source": "/kontakt/",
      "destination": "/en/#contacto",
      "permanent": true
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/200.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
